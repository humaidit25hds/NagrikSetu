# NagrikSetu Backend Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=NagrikSetu
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# AI provider
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_MODEL=gemini-3.6-flash
# Optional OpenAI fallback
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./nagriksetu.db
# For PostgreSQL: postgresql://user:password@localhost:5432/nagriksetu

# MongoDB document database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/NagricSetu
MONGODB_DB_NAME=NagrikSetu
MONGODB_TIMEOUT_MS=5000

# API Configuration
API_PREFIX=/api
API_V1_STR=/api/v1

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
